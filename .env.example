# Copy to .env.development.local. Local: printed by `supabase start` (API URL + publishable key).
# Production: Supabase dashboard → Project Settings → API Keys. Set the same
# variables in Netlify (Site configuration → Environment variables).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only (game engine). Never prefix it with VITE_: that would ship it to browsers.
SUPABASE_SECRET_KEY=
